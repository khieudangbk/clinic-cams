name: cams
services:
  db:
    container_name:
    image:
    environment:
      POSTGRES_DB:
      POSTGRES_USER:
      POSTGRES_PASSWORD:
    ports:
      - '5432:5432'
    volumes:
      - postgres_data:/var/lib/postgresql/data

  mailhog:
    # SC7 demo mail server: SMTP on 1025, web UI on http://localhost:8025 (no real email leaves your machine).
    image: mailhog/mailhog
    ports:
      - '1025:1025'
      - '8025:8025'

volumes:
  postgres_data: